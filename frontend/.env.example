# Public Supabase settings. Copy to frontend/.env.local for local runs,
# or set the same names in the host's environment for a deploy.
# Never put a real service-role key or real access codes in this file. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional. Password-reset emails use this origin when set. Leave unset locally
# so the link matches the page you're on. Production on the deployed host
# already uses https://campus-connect-seven-snowy.vercel.app/reset-password.
# NEXT_PUBLIC_SITE_URL=https://campus-connect-seven-snowy.vercel.app

# Optional, server-only. Ask Gemini uses the map without this, and uses Gemini when it is set.
# Never prefix this with NEXT_PUBLIC_.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional. Defaults match the buckets already set up in Supabase.
# NEXT_PUBLIC_SUPABASE_AVATAR_BUCKET=avatars
# NEXT_PUBLIC_SUPABASE_EVENT_IMAGES_BUCKET=event-images

# Temporary hackathon demo codes, server-only. Checked by /api/admin/event and
# /api/organization; never sent to the browser. Leave unset to turn them off.
# Never prefix these with NEXT_PUBLIC_.
# CAMPUS_ADMIN_EVENT_CODE=
# CAMPUS_ORG_ACCESS_CODE=
# Server-only. Lets those two routes change rows after checking a code. Set it in
# the host's server environment only.
# SUPABASE_SERVICE_ROLE_KEY=
